// Leandro Bisceglie's portfolio. The page is one screen: the rain city (scene.art), a rotating
// tagline, the links and two sheets (About and Work). Texts live in i18n.art.
state aboutOpen = false

state workOpen = false

computed SNIPPET = "// scene.art: a raindrop against the umbrella's canopy (an ellipse)\nlet lx = dx * ca + dy * sa\nlet ly = -dx * sa + dy * ca\nlet f = lx * lx / (R * R) + ly * ly / (ry * ry)\nif ly > R * 0.04 || f > 1 {\n  return 0\n}\n// outward normal of the ellipse, rotated back to the screen\nlet nx = (nlx * ca - nly * sa) / nl\nlet ny = (nlx * sa + nly * ca) / nl\nif isRain {\n  splash(p.x, p.y, p.vx, p.vy, nx, ny, u.vx, u.vy, 0.22, dripFloor())\n  u.wet += 1\n  return 1\n}"

page Home "/" {
  mount {
    let saved = null
    try {
      saved = localStorage.getItem("lb-lang")
    } catch (e) {
    }
    let pick = query.lang ?? saved
    if pick == "es" || pick == "en" {
      lang = pick
    }
  }
  effect {
    document.documentElement.lang = lang
  }

  meta title="Leandro Bisceglie · Software Engineer · Creator of ArtScript" description="Software Engineer with 10 years building for the web. Creator of ArtScript and Reactpify. React, Node.js, Shopify, WordPress and AEM. Mar del Plata, Argentina."
  column class="stage" tag=main {
    title "Leandro Bisceglie" tag=h1 class="sr-only"
    text t("aboutRole") tag=p class="sr-only"
    RainCity
    LangToggle
    column class="below" align=center {
      Tagline
      NavLinks
    }
    Chip
    Credit
  }
  AboutModal
  WorkModal
}

component Tagline {
  state i = 0
  state shown = true
  state glitch = false
  computed lines = t("taglines")
  computed line = lines[i % lines.length]
  // fade out, swap the line, fade in with a short glitch
  fn next() {
    shown = false
    setTimeout(swap, 250)
  }
  fn swap() {
    i = (i + 1) % lines.length
    shown = true
    glitch = true
    setTimeout(settle, 450)
  }
  fn settle() {
    glitch = false
  }
  mount {
    if window.matchMedia("(prefers-reduced-motion: reduce)").matches {
      return
    }
    // Paced by animation frames rather than setInterval: on the prerender requestAnimationFrame never
    // fires, while a real interval kept `art build --prerender` from exiting (ArtScript 0.2.9).
    let last = 0
    let raf = 0
    let tick = now => {
      if last == 0 {
        last = now
      } else if now - last >= 2800 {
        last = now
        next()
      }
      raf = requestAnimationFrame(tick)
    }
    raf = requestAnimationFrame(tick)
    cleanup {
      cancelAnimationFrame(raf)
    }
  }

  text line tag=p class=`tagline${shown ? "" : " hidden"}${glitch ? " glitch" : ""}` data-text=line aria-live="polite"
}

component NavLinks {
  row class="nav" tag=nav aria-label="Links" {
    link href=LINKS.linkedin target="_blank" class="navlink" style="--accent: #4cc9ff" aria-label=`LinkedIn ${t("opensNewTab")}` {
      text "" class="brand brand-linkedin"
      text "LinkedIn" class="navlink-label"
    }
    link href=LINKS.github target="_blank" class="navlink" style="--accent: #b892ff" aria-label=`GitHub ${t("opensNewTab")}` {
      text "" class="brand brand-github"
      text "GitHub" class="navlink-label"
    }
    link href=LINKS.email class="navlink" style="--accent: #ffc857" aria-label=t("email") {
      icon "mail" size=17
      text t("email") class="navlink-label"
    }
    button class="navlink" style="--accent: #6ee7b7" aria-haspopup="dialog" aria-expanded=workOpen -> workOpen = true {
      icon "grid" size=17
      text t("work") class="navlink-label"
    }
    button class="navlink" style="--accent: #ff4d5e" aria-haspopup="dialog" aria-expanded=aboutOpen -> aboutOpen = true {
      icon "user" size=17
      text t("about") class="navlink-label"
    }
  }
}

component LangToggle {
  row class="lang" role="group" aria-label=t("language") data-collide="1" {
    button "EN" class=(lang == "en" ? "on" : "") aria-pressed=(lang == "en") -> setLang("en")
    button "ES" class=(lang == "es" ? "on" : "") aria-pressed=(lang == "es") -> setLang("es")
  }
}

// What the umbrella did: drops it stopped while you held it, and your best.
component Chip {
  computed locale = lang == "es" ? "es-AR" : "en-US"

  if holding {
    row class="chip" aria-live="polite" {
      text `${stopped.toLocaleString(locale)} ${t("stopped")}` class="chip-count"
      text t("moveHint") class="chip-hint"
      button t("putBack") class="chip-btn" -> holding = false
    }
  } else if stopped > 0 {
    row class="chip" aria-live="polite" {
      text `${stopped.toLocaleString(locale)} ${t("stopped")}` class="chip-count"
      text `${t("best")} ${best.toLocaleString(locale)}` class="chip-best"
    }
  }
}

component Credit {
  row class="credit" tag=footer wrap justify=center {
    text t("builtWith")
    link "ArtScript" href=LINKS.artscript target="_blank" class="credit-art"
    text t("builtWhat") class="credit-what"
    link t("source") href=LINKS.source target="_blank" class="credit-src"
  }
}

component Dots {
  row class="dots" aria-hidden="true" {
    text "" class="dot dot-1"
    text "" class="dot dot-2"
    text "" class="dot dot-3"
  }
}

component AboutModal {
  state peek = false

  modal aboutOpen class="sheet" aria-labelledby="about-title" {
    row class="sheet-head" justify=between align=start {
      column {
        row class="eyebrow" {
          Dots
          text t("about")
        }
        title "Leandro Bisceglie" tag=h2 id="about-title" class="sheet-title"
        text t("aboutRole") tag=p class="sheet-sub"
      }
      button class="icon-btn" aria-label=t("close") -> aboutOpen = false {
        icon "x" size=20
      }
    }
    grid class="sheet-body about-body" {
      column {
        text t("aboutLead") tag=p class="lead"
        row class="chips" wrap role="list" aria-label="What I do" {
          for c in t("aboutChips") {
            text c class="chip-tag" role="listitem"
          }
        }
        column class="peek" {
          button class="peek-btn" aria-expanded=peek -> peek = !peek {
            text "</>" class="peek-icon" aria-hidden="true"
            column class="peek-text" {
              text t("peek") class="peek-title"
              text t("peekSub") class="peek-sub"
            }
            icon "chevron-down" class=(peek ? "chev open" : "chev")
          }
          if peek {
            text SNIPPET tag=p class="code"
          }
        }
      }
      grid class="facts" {
        text t("stack") class="fact-key"
        text t("stackValue") class="fact-value"
        text t("built") class="fact-key"
        text t("builtValue") class="fact-value"
        text t("clients") class="fact-key"
        text t("clientsValue") class="fact-value"
        text t("works") class="fact-key"
        text t("worksValue") class="fact-value"
      }
    }
    row class="sheet-foot" wrap {
      link href=LINKS.mailHello class="btn-primary" {
        icon "mail" size=16
        text "Email"
      }
      link href=LINKS.linkedin target="_blank" class="btn-link" aria-label=`LinkedIn ${t("opensNewTab")}` {
        text "LinkedIn"
        icon "external-link" size=14
      }
      link href=LINKS.github target="_blank" class="btn-link" aria-label=`GitHub ${t("opensNewTab")}` {
        text "GitHub"
        icon "external-link" size=14
      }
      link href="llms.txt" target="_blank" class="btn-link push" {
        text t("fullProfile")
      }
    }
  }
}

component WorkModal {
  modal workOpen class="sheet sheet-wide" aria-labelledby="work-title" {
    row class="sheet-head" justify=between align=start {
      column {
        row class="eyebrow" {
          Dots
          text t("work")
        }
        title t("workTitle") tag=h2 id="work-title" class="sheet-title"
        text t("workLead") tag=p class="sheet-sub"
      }
      button class="icon-btn" aria-label=t("close") -> workOpen = false {
        icon "x" size=20
      }
    }
    column class="sheet-body work-body" {
      grid class="projects" cols=1 md:cols=2 {
        for p in t("projects") {
          column class="project" tag=article {
            row class="project-head" justify=between {
              title p.name tag=h3 class="project-name"
              text p.role class="project-role"
            }
            text p.text tag=p class="project-text"
            row class="tags" wrap {
              for tg in p.tags {
                text tg class="tag"
              }
            }
            row class="project-links" wrap {
              for l in p.links {
                link href=l.href target="_blank" class="btn-link" {
                  text l.label
                  icon "external-link" size=14
                }
              }
            }
          }
        }
      }
      title t("experience") tag=h3 class="section-label"
      column class="timeline" {
        for j in t("jobs") {
          grid class="job" {
            text j.years class="job-years"
            column {
              row class="job-head" wrap {
                text j.role class="job-role"
                text j.company class="job-company"
              }
              text j.text tag=p class="job-text"
            }
          }
        }
      }
    }
  }
}

test "shows the name and opens About" {
  open "/"
  see "Leandro Bisceglie"
  click "About"
  see "Ten years shipping for the web"
  see "WordPress, Shopify, AEM"
}

test "switches to Spanish" {
  open "/"
  click "ES"
  see "Sobre mí"
  click "Sobre mí"
  see "Diez años construyendo para la web"
}

test "lists the projects and the experience" {
  open "/"
  click "Work"
  see "Reactpify"
  see "World of Argentum"
  see "Leniolabs"
}
