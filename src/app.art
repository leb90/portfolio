// Leandro Bisceglie's portfolio. The page is one screen: the rain city (scene.art), a rotating
// tagline, the links and two sheets (About and Work). Texts live in i18n.art.
state panelOpen = false

// Which tab of the panel shows: "about" or "projects".
state panel = "about"

computed SNIPPET = "// scene.art: a raindrop against the umbrella's canopy (an ellipse)\nlet lx = dx * ca + dy * sa\nlet ly = -dx * sa + dy * ca\nlet f = lx * lx / (R * R) + ly * ly / (ry * ry)\nif ly > R * 0.04 || f > 1 {\n  return 0\n}\n// outward normal of the ellipse, rotated back to the screen\nlet nx = (nlx * ca - nly * sa) / nl\nlet ny = (nlx * sa + nly * ca) / nl\nif isRain {\n  splash(p.x, p.y, p.vx, p.vy, nx, ny, u.vx, u.vy, 0.22, dripFloor())\n  u.wet += 1\n  return 1\n}"

page Home "/" {
  mount {
    let saved = null
    try {
      saved = localStorage.getItem("lb-lang")
    } catch (e) {
    }
    let pick = query.lang ?? saved
    if pick == "es" || pick == "en" {
      lang = pick
    }
  }
  effect {
    document.documentElement.lang = lang
  }

  meta title="Leandro Bisceglie · Software Engineer · Creator of ArtScript" description="Software Engineer with 10+ years building software. Creator of ArtScript and Reactpify. TypeScript, Node.js, React, AWS and Shopify. Mar del Plata, Argentina."
  column class="stage" tag=main {
    title "Leandro Bisceglie" tag=h1 class="sr-only"
    text t("aboutRole") tag=p class="sr-only"
    RainCity
    LangToggle
    column class="below" align=center {
      Tagline
      NavLinks
    }
    Chip
    Credit
  }
  Panel
}

component Tagline {
  state i = 0
  state shown = true
  state glitch = false
  computed lines = t("taglines")
  computed line = lines[i % lines.length]
  // fade out, swap the line, fade in with a short glitch
  fn next() {
    shown = false
    setTimeout(swap, 250)
  }
  fn swap() {
    i = (i + 1) % lines.length
    shown = true
    glitch = true
    setTimeout(settle, 450)
  }
  fn settle() {
    glitch = false
  }
  mount {
    if window.matchMedia("(prefers-reduced-motion: reduce)").matches {
      return
    }
    // Paced by animation frames rather than setInterval: on the prerender requestAnimationFrame never
    // fires, while a real interval kept `art build --prerender` from exiting (ArtScript 0.2.9).
    let last = 0
    let raf = 0
    let tick = now => {
      if last == 0 {
        last = now
      } else if now - last >= 2800 {
        last = now
        next()
      }
      raf = requestAnimationFrame(tick)
    }
    raf = requestAnimationFrame(tick)
    cleanup {
      cancelAnimationFrame(raf)
    }
  }

  text line tag=p class=`tagline${shown ? "" : " hidden"}${glitch ? " glitch" : ""}` data-text=line aria-live="polite"
}

component NavLinks {
  row class="nav" tag=nav aria-label="Links" {
    link href=LINKS.linkedin target="_blank" class="navlink" style="--accent: #4cc9ff" aria-label=`LinkedIn ${t("opensNewTab")}` {
      text "" class="brand brand-linkedin"
      text "LinkedIn" class="navlink-label"
    }
    link href=LINKS.github target="_blank" class="navlink" style="--accent: #b892ff" aria-label=`GitHub ${t("opensNewTab")}` {
      text "" class="brand brand-github"
      text "GitHub" class="navlink-label"
    }
    link href=LINKS.email class="navlink" style="--accent: #ffc857" aria-label=t("email") {
      icon "mail" size=17
      text t("email") class="navlink-label"
    }
    button class="navlink" style="--accent: #6ee7b7" aria-haspopup="dialog" aria-expanded=(panelOpen && panel == "projects") -> openPanel("projects") {
      icon "grid" size=17
      text t("projectsTab") class="navlink-label"
    }
    button class="navlink" style="--accent: #ff4d5e" aria-haspopup="dialog" aria-expanded=(panelOpen && panel == "about") -> openPanel("about") {
      icon "user" size=17
      text t("about") class="navlink-label"
    }
  }
}

component LangToggle {
  row class="lang" role="group" aria-label=t("language") data-collide="1" {
    button "EN" class=(lang == "en" ? "on" : "") aria-pressed=(lang == "en") -> setLang("en")
    button "ES" class=(lang == "es" ? "on" : "") aria-pressed=(lang == "es") -> setLang("es")
  }
}

// What the umbrella did: drops it stopped while you held it, and your best.
component Chip {
  computed locale = lang == "es" ? "es-AR" : "en-US"

  if holding {
    row class="chip" aria-live="polite" animate=rise {
      text `${stopped.toLocaleString(locale)} ${t("stopped")}` class="chip-count"
      text t("moveHint") class="chip-hint"
      button t("putBack") class="chip-btn" -> holding = false
    }
  } else if stopped > 0 {
    row class="chip" aria-live="polite" animate=rise {
      text `${stopped.toLocaleString(locale)} ${t("stopped")}` class="chip-count"
      text `${t("best")} ${best.toLocaleString(locale)}` class="chip-best"
    }
  }
}

component Credit {
  row class="credit" tag=footer wrap justify=center {
    text t("builtWith")
    link "ArtScript" href=LINKS.artscript target="_blank" class="credit-art"
    text t("builtWhat") class="credit-what"
    link t("source") href=LINKS.source target="_blank" class="credit-src"
  }
}

fn openPanel(which) {
  panel = which
  panelOpen = true
}

// In alphabetical order: a list of places, not a timeline.
computed COMPANIES = ["Avalith", "DEPT®", "GamSoft", "Globant", "Leniolabs", "Parser", "SmartAdTags"]

computed TOOLS = [
  "TypeScript", "JavaScript", "Node.js", "React", "GraphQL", "AWS", "GCP", "DynamoDB", "MySQL",
  "Terraform", "GitHub Actions", "Shopify", "WordPress", "AEM", "Jest", "Cypress", "Storybook"
]

// About and Projects share one panel that slides in from the right: the city keeps raining beside it,
// and the tabs switch between them without closing it.
component Panel {
  ref body
  effect {
    if panel && body {
      body.scrollTop = 0
    }
  }

  modal panelOpen class="panel" aria-label=(panel == "about" ? t("about") : t("projectsTab")) {
    row class="panel-bar" justify=between {
      tabs panel options=[{ value: "about", label: t("about") }, { value: "projects", label: t("projectsTab") }] class="panel-tabs"
      button class="panel-close" aria-label=t("close") -> panelOpen = false {
        text t("backToRain") class="panel-close-text"
        icon "x" size=18
      }
    }
    // Mounted only while open: the stats count up and the blocks appear each time it opens.
    column ref=body class="panel-body" {
      if panelOpen {
        if panel == "about" {
          About
        } else {
          Projects
        }
      }
    }
  }
}

component About {
  state peek = false
  state copied = false
  // "Copied" only once the browser has the address (it can refuse: no focus, no permission).
  fn copyEmail() {
    try {
      await navigator.clipboard.writeText(LINKS.address)
      copied = true
      setTimeout(() => copied = false, 1800)
    } catch (e) {
    }
  }

  // Each block appears as it scrolls into view, one after another (`reveal`, ArtScript 0.2.10).
  column class="about" {
    column class="block" reveal {
      title t("hello") tag=h2 class="panel-title"
      text t("aboutRole") tag=p class="panel-kicker"
      text t("aboutLead") tag=p class="about-lead"
      text t("aboutMore") tag=p class="about-text"
    }
    grid class="stats" cols=3 reveal {
      for s in t("stats") {
        column class="stat" {
          if s.to {
            Counter to=s.to suffix=(s.suffix ?? "") cls="stat-n"
          } else {
            text s.n class="stat-n"
          }
          text s.label class="stat-label"
        }
      }
    }
    column class="block" reveal {
      title t("toolsTitle") tag=h3 class="panel-h3"
      row class="tools" wrap {
        for d in t("disciplines") {
          text d class="tool"
        }
      }
      row class="tools small" wrap {
        for x in TOOLS {
          text x class="tool"
        }
      }
    }
    column class="block" reveal {
      title t("companiesTitle") tag=h3 class="panel-h3"
      row class="companies" wrap {
        for c in COMPANIES {
          text c class="company"
        }
      }
      link href=LINKS.linkedin target="_blank" class="out history" aria-label=`${t("history")} ${t("opensNewTab")}` {
        text t("history")
        icon "arrow-right" size=14
      }
    }
    column class="block" reveal {
      title t("ownTitle") tag=h3 class="panel-h3"
      text t("ownText") tag=p class="about-text"
      button class="text-btn" -> panel = "projects" {
        text t("seeProjects")
        icon "arrow-right" size=16
      }
    }
    column class="umbrella" reveal {
      text t("umbrellaText") tag=p class="about-text"
      button class="text-btn" aria-expanded=peek -> peek = !peek {
        text peek ? t("hideCode") : t("showCode")
        icon "chevron-down" size=16 class=(peek ? "chev open" : "chev")
      }
      if peek {
        text SNIPPET tag=pre class="code" animate=rise
      }
    }
    column class="contact" reveal {
      title t("talk") tag=h3 class="panel-h3"
      row class="mail" wrap {
        link LINKS.address href=LINKS.mailHello class="mail-link"
        button class=(copied ? "copy done" : "copy") -> copyEmail() {
          if copied {
            icon "check" size=14 animate=pop
          } else {
            icon "copy" size=14
          }
          text copied ? t("copied") : t("copy")
        }
      }
      row class="elsewhere" wrap {
        link href=LINKS.linkedin target="_blank" class="out" aria-label=`LinkedIn ${t("opensNewTab")}` {
          text "LinkedIn"
          icon "arrow-right" size=14
        }
        link href=LINKS.github target="_blank" class="out" aria-label=`GitHub ${t("opensNewTab")}` {
          text "GitHub"
          icon "arrow-right" size=14
        }
        link href="llms.txt" target="_blank" class="out" {
          text t("fullProfile")
          icon "arrow-right" size=14
        }
      }
    }
  }
}

component Projects {
  column class="personal" {
    column class="block" reveal {
      title t("workTitle") tag=h2 class="panel-title"
      text t("workLead") tag=p class="panel-kicker"
    }
    column class="projects" {
      for p in t("projects") {
        column class="project" tag=article reveal {
          row class="project-head" justify=between align=end wrap {
            title p.name tag=h3 class="project-name"
            text p.role class="project-role"
          }
          text p.text tag=p class="project-text"
          row class="tools small" wrap {
            for tg in p.tags {
              text tg class="tool"
            }
          }
          row class="project-links" wrap {
            for l in p.links {
              link href=l.href target="_blank" class="out" {
                text l.label
                icon "arrow-right" size=14
              }
            }
          }
        }
      }
    }
  }
}

test "shows the name and opens About" {
  open "/"
  see "Leandro Bisceglie"
  click "About"
  see "Over ten years building software"
  see "WordPress"
  see "Let's talk"
}

test "switches between About and Projects inside the panel" {
  open "/"
  click "About"
  see "Hi, I'm Leandro."
  click "Projects" 1
  see "Personal projects"
  notSee "Hi, I'm Leandro."
}

test "switches to Spanish" {
  open "/"
  click "ES"
  see "Sobre mí"
  click "Sobre mí"
  see "Más de diez años construyendo software"
}

test "keeps personal projects apart from company work" {
  open "/"
  click "Projects"
  see "Reactpify"
  see "World of Argentum"
  notSee "Leniolabs"
  see "Ático de Hisui"
  click "About" 1
  see "Leniolabs"
  see "Full history on LinkedIn"
  click "See my personal projects"
  see "Personal projects"
}
