// Every visible string, in English (default) and Spanish. `t("key")` reads the current language,
// so any text that uses it updates when `lang` changes.
state lang = "en"

fn t(key) {
  return DICT[lang][key] ?? DICT.en[key] ?? key
}

fn setLang(next) {
  lang = next
  try {
    localStorage.setItem("lb-lang", next)
  } catch (e) {
  }
}

